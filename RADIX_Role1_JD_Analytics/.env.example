# Copy this file to .env and add your own keys. Never share your .env.
GEMINI_API_KEY=
# Set this to a model available to your Google AI Studio account.
GEMINI_MODEL=gemini-3.8-flash

OPENROUTER_API_KEY=
# Set this to a model enabled for your OpenRouter account.
OPENROUTER_MODEL=google/gemini-2.5-flash:free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=RADIX Talent Match

# Optional: direct OpenAI key only if you have one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
